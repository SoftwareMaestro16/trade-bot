# Копия для локальной разработки: cp .env.example .env, затем заполнить.
# .env в .gitignore с первого коммита (ТАБУ п.2). Ничего сюда со значениями не коммитить.
#
# ВАЖНО: значения вписываются в .env прямо в редакторе, локально.
# Секреты никогда не идут в чат с ассистентом — раздел 3 брифа. Если секрет
# всё же попал в переписку (скопирован туда по ошибке) — считать его
# скомпрометированным и перевыпустить, а не переиспользовать.

# testnet | mainnet — обязательное. RR-05: разные ключи для разных сред,
# бот отказывается стартовать при несовпадении.
APP_ENV=testnet

# Строка подключения к Postgres (+TimescaleDB). Фаза 1 не пишет позиции,
# только рыночные данные, но схема БД общая с первого дня.
DATABASE_URL=postgres://user:password@localhost:5432/trade_bot

# --- Bybit API ключи ---
# Фаза 1 (сборщик данных) работает на публичных эндпоинтах — ничего из блока ниже
# не требуется. Не заводить ключ раньше, чем он реально нужен (бриф, раздел 3).

# Testnet: testnet.bybit.com -> Профиль -> API. Права: Trade + Read, БЕЗ Withdrawal.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Mainnet: только боевая фаза (Фаза 4). Отдельный ключ, отдельные переменные —
# перепутать с testnet невозможно по конструкции (RR-05).
BYBIT_MAINNET_API_KEY=
BYBIT_MAINNET_API_SECRET=

# --- Telegram: алерты и kill switch (RR-30..RR-38) ---
# Нужны не раньше Фазы 2-3 (notify/, killswitch-listener), но можно завести заранее.
# Токен: @BotFather -> /mybots -> выбрать бота -> API Token.
# Если токен когда-либо был вставлен в чат/переписку — считать его протухшим,
# отозвать через BotFather (Revoke current token) и вписать сюда новый.
TELEGRAM_BOT_TOKEN=

# chat_id: @userinfobot. RR-33 — единственный chat_id в белом списке,
# команды от всех остальных отклоняются.
TELEGRAM_CHAT_ID=

# RR-36: watchdog-алерты идут по независимому каналу — отдельный бот,
# отдельный токен, чтобы падение основного Telegram-бота не значило тишину.
# Завести отдельным ботом через BotFather, когда дойдём до Фазы 3 (watchdog/).
TELEGRAM_WATCHDOG_BOT_TOKEN=

HEALTHCHECK_PING_URL=

LLM_API_KEY=

# --- Kill switch (killswitch-listener.ts) ---
# Путь файлового флага уровня 1. Опционально — без значения используется
# <cwd>/KILLSWITCH_STOP.
# KILLSWITCH_FLAG_PATH=

# --- Внешний heartbeat (RUNBOOK.md §4) ---
# Опционально. Без него единственный способ узнать, что сборщик упал, — зайти
# и проверить руками (systemctl status / journalctl). Со значением — collector.ts
# пингует эту ссылку на таймере; сторонний сервис (healthchecks.io или аналог)
# алертит владельца отдельным каналом, если пинг не пришёл вовремя — независимо
# от того, жив ли сам процесс/Telegram-бот, чтобы прислать алерт самостоятельно.
# Завести бесплатный check на healthchecks.io, вставить его ping URL сюда.
# HEALTHCHECK_PING_URL=

# --- VPS / деплой (Фаза 1+, когда сборщик данных готов стартовать по-настоящему) ---
# Не нужно для локальной разработки. Заполняется на самом VPS, не здесь.
# FIXED_IP=
