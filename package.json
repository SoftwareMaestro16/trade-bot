{
  "name": "trade-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "collect": "node --env-file=.env dist/collector.js",
    "killswitch-listener": "node --env-file=.env dist/killswitch-listener.js",
    "backfill:funding": "node --env-file=.env dist/scripts/backfillFundingHistory.js",
    "fetch:margin-tiers": "node dist/scripts/fetchMarginTierData.js",
    "migrate:up": "node-pg-migrate up -j sql --envPath .env",
    "migrate:down": "node-pg-migrate down -j sql --envPath .env",
    "migrate:create": "node-pg-migrate create -j sql"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "bybit-api": "^4.7.3",
    "kysely": "^0.29.4",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.4",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "nock": "^14.0.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.8"
  }
}
